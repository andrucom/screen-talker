func on_startup():
	letters.clear()
	
	var logs = [
		"Zer0Soft (tm) Operating System",
		"RDOS Версия 4.00",
		"Copyright (c) 1992-1996 Zer0Soft Corp. Все права защищены.",
		" ",
		"Инициализация системной шины...",
		"Обнаружен процессор: 80486DX2-66",
		"Тест памяти: 16384 КБ ОЗУ установлено, 16384 КБ ОК",
		"Загрузка базовых драйверов...",
		"HIMEM.ZERO: менеджер расширенной памяти, версия 3.15",
		"EMM386.ZERO: эмуляция EMS 4.0, используется страничный кадр D000h",
		"Установка обработчиков прерываний...",
		"Загрузка таблицы векторов прерываний... OK",
		"Инициализация контроллера клавиатуры... OK",
		"Поиск накопителей:",
		"  Дисковод A: 3.5'', 1.44 МБ, присутствует",
		"  Дисковод B: отсутствует",
		"  Диск C: 850 МБ, IDE, тип FAT16, метка ''SYS_DRIVE''",
		"  Диск D: CD-ROM, ATAPI, метка ''RDOS_SETUP''",
		" ",
		"Загрузка COMMAND.ZER0..."
	]
	
	letters.clear(Color.DARK_BLUE)
	var y_level = 6
	for log_text in logs:
		letters.write_string(1, y_level, log_text, Color.WHITE, Color.DARK_BLUE)
		y_level += 1
		await sleep(randf_range(0.05, 0.3))
	
	y_level += 2
	
	var img_data = LAUNCH_LOG_IMAGE.get_image()
	for img_y in range(LAUNCH_LOG_IMAGE.get_height()):
		await sleep(0.01)
		for img_x in range(LAUNCH_LOG_IMAGE.get_width()):
			letters.set_letter(
				1 + img_x, 
				y_level + img_y, 
				grayscale_to_ascii[img_data.get_pixel(img_x, img_y).r * 255],
				Color.RED,
				Color.DARK_BLUE
			)
	
	await sleep(3.0)
	
	can_paint_header = false
	letters.clear()
	
	await sleep(1.0)
	
	run_program("terminal")
	kill_self()

func on_update(delta: float):
	time += delta
	if can_paint_header:
		var fucking_red = Color(sin(time * 3), 0.0, 0.0)
		letters.clear_area(0, letters.width, 0, 3, fucking_red)
		letters.write_string(2, 1, "Запуск - Bootloader", Color.WHITE, fucking_red)
