// Указываем, что шейдер предназначен для 2D элементов (спрайтов, текстур)
shader_type canvas_item;
// Режим смешивания: обычное наложение пикселей (не прозрачный, не аддитивный)
render_mode blend_mix;

// Это специальная текстура - то, что уже отрисовано на экране до этого шейдера
// hint_screen_texture говорит, что это снимок экрана
// filter_linear_mipmap - плавное сглаживание при масштабировании
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

// Главная функция шейдера - обрабатывает каждый пиксель отдельно
void fragment() {
  // Берем цвет пикселя с экрана в текущей позиции (SCREEN_UV - координаты экрана)
  vec4 color = texture(SCREEN_TEXTURE, SCREEN_UV);
  
  // Увеличиваем яркость в 3 раза (делаем картинку светлее)
  // Чем больше число, тем ярче - здесь просто умножение всех цветов (R,G,B) на 3
  color *= 20.0;
  
  // Настройки для эффекта свечения (glow)
  float size = 0.003;        // Радиус свечения (1% от размера экрана)
  float size_step = size * 0.1;  // Шаг между соседними точками (0.001)
  
  // ДВА ВЛОЖЕННЫХ ЦИКЛА! Они пробегают по квадрату вокруг пикселя
  // x и y меняются от -0.01 до +0.01 с шагом 0.001
  // Это значит, что мы проверим 21x21 = 441 соседний пиксель
  for (float x = -size; x < size; x += size_step) {
    for (float y = -size; y < size; y += size_step) {
      // Сдвиг координат (куда смотреть относительно текущего пикселя)
      vec2 uv_offset = vec2(x, y);
      // Новые координаты = текущие + сдвиг
      vec2 uv_with_offset = SCREEN_UV + uv_offset;
      
      // Защита от выхода за границы экрана
      // clamp ограничивает значения между 0 и 1 (0 - левый/верхний край, 1 - правый/нижний)
      uv_with_offset = clamp(vec2(0.0), vec2(1.0), uv_with_offset);
      
      // Получаем цвет соседнего пикселя
      vec4 color_glow = texture(SCREEN_TEXTURE, uv_with_offset);
      
      // Добавляем его цвет к текущему, но очень слабо (0.03 = 3% от соседнего цвета)
      // Так создается эффект размытого свечения
      color.rgb += color_glow.rgb * 0.02;
    }
  }
  
  // Создаем ЭФФЕКТ СТРОК (как на старых телевизорах)
  // UV.y - вертикальная координата (0 вверху, 1 внизу)
  // TIME - время в секундах (меняется автоматически)
  // sin(...) создает волну: то +1, то -1, то 0
  // Умножение на 500 делает полоски очень частыми
  vec4 color_scanlines = color * sin((UV.y + TIME * 0.5) * 100.0);
  
  // Смешиваем обычное изображение со строками:
  // 20% строк, 80% обычного цвета
  color = mix(color, color_scanlines, 0.2);
  
  // Добавляем дополнительные 30% яркости от строк (делаем их заметнее)
  color += color_scanlines * 0.3;
  
  // ВАЖНО: Переменная COLOR - это финальный цвет пикселя
  // Всё, что мы записали выше - это математика, а здесь - результат
  COLOR = color;
}



